# Copiado para infra/.env no servidor pelo vps-bootstrap.sh. Valores reais
# nunca vão para o git.

# Proxy. Com Coolify no servidor (Traefik dele em 80/443):
COMPOSE_FILE=docker-compose.yml:docker-compose.coolify.yml
TRAEFIK_HTTP_ENTRYPOINT=http
TRAEFIK_HTTPS_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=letsencrypt
# Servidor sem Coolify: apague a linha COMPOSE_FILE e use o Caddy do repositório:
# COMPOSE_PROFILES=caddy

BASE_DOMAIN=SEU_IP_COM_HIFENS.sslip.io
ACME_EMAIL=kevin.azal@catolicasc.edu.br
POSTGRES_USER=athonis
POSTGRES_PASSWORD=troque-por-uma-senha-forte
GRAFANA_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Tags das imagens em uso (deploy.sh atualiza estas linhas)
API_TAG=main
API_STAGING_TAG=staging
WEB_TAG=main
WEB_STAGING_TAG=staging

# Branch do repositório de onde o servidor lê esta pasta infra/
INFRA_BRANCH=desenvMobile
