# Copie para api.staging.env na VM (o arquivo real não vai para o git).
JWT_SECRET=gere-com-node-crypto-randomBytes-48
JWT_EXPIRATION=1h
JWT_REFRESH_DAYS=30
CORS_ORIGIN=https://staging-app.SEU_DOMINIO
GOOGLE_GEOCODING_API_KEY=
GOOGLE_PROJECT_ID=
# Opcional. Com valor, GET /metrics exige "Authorization: Bearer <token>"; o
# Prometheus manda o mesmo valor, lido de infra/secrets/metrics_token. O
# vm-configure.sh gera os dois numa instalação nova. Vazio: sem token (o
# /metrics continua fechado para a internet pelo proxy).
METRICS_TOKEN=
TRUST_PROXY=1
