# Banco de Dados
DB_TYPE=sqlite
DB_NAME=./src/database/database.sqlite

# Servidor
PORT=8080
NODE_ENV=development

# JWT (obrigatório em produção)
JWT_SECRET=seu-secret-super-seguro-aqui
JWT_EXPIRATION=1h

# CORS (opcional - em produção, liste origens permitidas separadas por vírgula)
# CORS_ORIGIN=https://app.exemplo.com,https://admin.exemplo.com

# Google Maps - Geocoding e Street View
GOOGLE_GEOCODING_API_KEY=sua-chave-da-api-google-maps

# Google Maps - Route Optimization (opcional)
GOOGLE_PROJECT_ID=seu-projeto-google-cloud
# GOOGLE_APPLICATION_CREDENTIALS=caminho/para/client_secret.json
