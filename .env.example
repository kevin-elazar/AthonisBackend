# ============================================
# OBRIGATÓRIAS — a aplicação não sobe sem elas
# ============================================

# Segredo de assinatura do JWT. Gere um valor aleatório forte:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NÃO existe valor padrão: um deploy sem esta variável falha no boot de propósito.
JWT_SECRET=

# Origens permitidas no CORS, separadas por vírgula.
# Obrigatória quando NODE_ENV=production.
# CORS_ORIGIN=https://app.exemplo.com,https://admin.exemplo.com

# ============================================
# Opcionais
# ============================================

# Banco de dados
DB_TYPE=sqlite
DB_NAME=./src/database/database.sqlite

# Servidor
PORT=8080
NODE_ENV=development

# Validade do token
JWT_EXPIRATION=1h

# Validade da sessao do aplicativo do entregador, em dias (refresh token)
JWT_REFRESH_DAYS=30

# Diretório raiz dos arquivos de importação (subpastas são criadas por empresa)
UPLOADS_DIR=importacoes

# Google Maps — Geocoding e Street View (server-side).
# Esta chave NUNCA é enviada ao navegador: as imagens do Street View são
# servidas pelo próprio backend em /street-view/order/:id/image
GOOGLE_GEOCODING_API_KEY=

# Google Maps — Route Optimization (opcional)
GOOGLE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=caminho/para/client_secret.json
